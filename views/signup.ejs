<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up | MoodAnswer AI</title>
    <link rel="stylesheet" href="css/global.css" />
  </head>
  <body>
    <main class="login-shell auth-only">
      <section class="login-panel" aria-label="Signup form">
        <p class="eyebrow">Create account</p>
        <h1>Join MoodAnswer AI</h1>
        <p class="login-copy">
          Create an account with email to save your mood-aware answers.
        </p>

        <form id="signupForm" class="login-form">
          <label class="field-label" for="name">Name</label>
          <input
            id="name"
            name="name"
            autocomplete="name"
            placeholder="Your name"
          />

          <label class="field-label" for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />

          <label class="field-label" for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            placeholder="At least 6 characters"
            minlength="6"
            required
          />

          <button type="submit">Create account</button>
          <p id="signupMessage" class="form-message" aria-live="polite"></p>
        </form>

        <p class="auth-switch">
          Already have an account? <a href="/login">Login</a>
        </p>
      </section>
    </main>

    <script src="js/api.js"></script>
    <script src="js/theme.js"></script>
    <script src="js/auth.js"></script>
  </body>
</html>
