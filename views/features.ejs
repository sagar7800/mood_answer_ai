<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Features | MoodAnswer AI</title>
    <link rel="stylesheet" href="css/global.css" />
  </head>

  <body class="feature-body">
    <header class="navbar">
      <div class="nav-container">
        <a class="logo" href="/" aria-label="MoodAnswer AI home">
          <span class="logo-icon">✦</span>
          <span>
            <strong>MoodAnswer AI</strong>
            <small>Adaptive AI workspace</small>
          </span>
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="/ask">Ask</a>
          <a href="/rooms">Rooms</a>
          <a href="/games">Games</a>
          <a class="active" href="/features">Features</a>
          <a href="/history">History</a>
        </nav>

        <div class="session-actions">
          <span id="sessionUser" class="status-pill">Signed in</span>
          <button id="logoutButton" class="ghost-button" type="button">
            Logout
          </button>
        </div>
      </div>
    </header>

    <main class="feature-main">
      <section class="feature-hero-clean" aria-labelledby="featureHeroTitle">
        <div>
          <p class="feature-eyebrow">Product features</p>
          <h1 id="featureHeroTitle">Built for answers that match the user’s state.</h1>
          <p>
            MoodAnswer AI combines mood-aware answering, adaptive chat rooms,
            safe fun modes, voice input, and saved history in one simple
            conversational platform.
          </p>

          <div class="feature-hero-actions" aria-label="Feature page actions">
            <a class="primary-link" href="/ask">Start asking</a>
            <a class="secondary-link" href="/rooms">Explore rooms</a>
          </div>
        </div>

        <aside class="feature-summary-panel" aria-label="MoodAnswer AI feature summary">
          <div class="feature-summary-top">
            <strong>Adaptive response system</strong>
            <span>Live concept</span>
          </div>

          <div class="feature-summary-list">
            <div>
              <span>01</span>
              <p>Question + mood + language preferences are collected.</p>
            </div>
            <div>
              <span>02</span>
              <p>AI response is shaped for tone, length, safety, and context.</p>
            </div>
            <div>
              <span>03</span>
              <p>Answer history is saved so users can revisit or delete it.</p>
            </div>
          </div>
        </aside>
      </section>

      <section class="feature-section-clean" aria-labelledby="coreFeaturesTitle">
        <div class="feature-section-head">
          <p class="section-label">Core features</p>
          <h2 id="coreFeaturesTitle">Clear features with clear purpose.</h2>
          <p>
            Each feature supports the main goal: make AI answers easier to
            understand, safer to use, and more comfortable for different moods.
          </p>
        </div>

        <div class="feature-grid-clean">
          <article class="feature-capability-card">
            <span class="feature-number">01</span>
            <h3>Mood selection</h3>
            <p>
              Users select how they feel before asking, so the answer can match
              normal, confused, stressed, sad, angry, curious, or tired moods.
            </p>
          </article>

          <article class="feature-capability-card">
            <span class="feature-number">02</span>
            <h3>Tone control</h3>
            <p>
              The same answer can become simple, detailed, short, calm,
              motivational, or example-based without changing the facts.
            </p>
          </article>

          <article class="feature-capability-card">
            <span class="feature-number">03</span>
            <h3>Adaptive AI rooms</h3>
            <p>
              Study Room, Coding Help, FunTalk, Meme Zone, Gaming Lounge, and
              Chill Café create different conversation experiences.
            </p>
          </article>

          <article class="feature-capability-card">
            <span class="feature-number">04</span>
            <h3>History dashboard</h3>
            <p>
              Saved questions are shown in a clean list. Users can open full
              details or delete answers they no longer need.
            </p>
          </article>

          <article class="feature-capability-card">
            <span class="feature-number">05</span>
            <h3>Voice support</h3>
            <p>
              Voice input helps users ask faster, while answers stay readable
              for read-aloud experiences.
            </p>
          </article>

          <article class="feature-capability-card">
            <span class="feature-number">06</span>
            <h3>Safe humor and support</h3>
            <p>
              The assistant can add light jokes only when appropriate and keeps
              serious topics respectful and joke-free.
            </p>
          </article>
        </div>
      </section>

      <section class="feature-section-clean feature-split-section" aria-labelledby="workflowTitle">
        <div class="feature-section-head">
          <p class="section-label">Workflow</p>
          <h2 id="workflowTitle">A simple flow users can understand instantly.</h2>
        </div>

        <div class="feature-flow-grid">
          <article>
            <span>1</span>
            <h3>Ask</h3>
            <p>User writes a question or starts with voice input.</p>
          </article>

          <article>
            <span>2</span>
            <h3>Set mood</h3>
            <p>User chooses mood, language, answer length, and optional modes.</p>
          </article>

          <article>
            <span>3</span>
            <h3>Generate</h3>
            <p>The answer appears in the selected tone with safety rules applied.</p>
          </article>

          <article>
            <span>4</span>
            <h3>Save</h3>
            <p>The response is stored in history for review, reuse, or deletion.</p>
          </article>
        </div>
      </section>

      <section class="feature-section-clean" aria-labelledby="moodBehaviorTitle">
        <div class="feature-section-head">
          <p class="section-label">Mood behavior</p>
          <h2 id="moodBehaviorTitle">Different moods, different response styles.</h2>
        </div>

        <div class="feature-mood-grid">
          <article>
            <strong>Confused</strong>
            <p>Simple words, slow steps, and easy examples.</p>
          </article>
          <article>
            <strong>Stressed</strong>
            <p>Short, calm, reassuring answers without overload.</p>
          </article>
          <article>
            <strong>Sad</strong>
            <p>Gentle and warm wording while still staying clear.</p>
          </article>
          <article>
            <strong>Angry</strong>
            <p>Respectful, direct, calm tone without argument.</p>
          </article>
          <article>
            <strong>Curious</strong>
            <p>Deeper details, extra context, and useful explanation.</p>
          </article>
          <article>
            <strong>Tired</strong>
            <p>Very short, simple, easy-to-read answers.</p>
          </article>
        </div>
      </section>

      <section class="feature-cta-clean" aria-labelledby="featureCtaTitle">
        <div>
          <p class="section-label">Try it now</p>
          <h2 id="featureCtaTitle">Ask one question and see the tone adapt.</h2>
          <p>
            Start with any topic, select a mood, and generate an answer that
            feels clearer for that moment.
          </p>
        </div>
        <a class="primary-link" href="/ask">Start asking</a>
      </section>
    </main>

    <footer>
      <p>© 2026 MoodAnswer AI. Built for clear, safe, mood-aware answers.</p>
    </footer>

    <script src="js/api.js"></script>
    <script src="js/theme.js"></script>
    <script src="js/app.js"></script>
  </body>
</html>
